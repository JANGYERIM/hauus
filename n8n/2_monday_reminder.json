   "parameters": {
    "jsCode": "\nconst c=$('리마인드 대상 계산').item.json;\nconst body=($json.content||[]).map(b=>b.text||'').join('').trim();\nreturn [{json:{...c,draft:body,\n  tg:`👁 ${c.name}님 · ${c.lastService} · ${c.weeks}주 전 방문 (총 ${c.visits}회)\\n연락처 ${c.phone}\\n\\n${body}`}}];\n"
   },
