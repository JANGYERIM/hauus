  {
   "parameters": {
    "jsCode": "\n// 시술기록 + 보냄기록 → 이번 주 리마인드 대상 (5주+ & 이후 방문 없음 & 아직 안 보냄)\nconst WEEKS=5;\nconst recs=$('시술기록 읽기').all().map(i=>i.json);\nconst sent=$('보냄기록 읽기').all().map(i=>i.json);\nconst today=new Date();today.setHours(0,0,0,0);\nconst skip=/취소|노쇼|거절/;\nconst cust={};\nfor(const r of recs){\n  if(!r.고객명||!r.이용일||skip.test(r.상태||''))continue;\n  const k=`${r.고객명}|${r.연락처}`;\n  const c=cust[k]||(cust[k]={key:k,name:r.고객명,phone:r.연락처,visits:0,last:'',lastService:''});\n  c.visits++; if(r.이용일>c.last){c.last=r.이용일;c.lastService=r.시술}\n}\nconst lastSent={}; for(const s of sent){const k=`${s.고객명}|${s.연락처}`; if(!lastSent[k]||s.보낸날>lastSent[k])lastSent[k]=s.보낸날}\nconst out=[];\nfor(const c of Object.values(cust)){\n  const days=Math.floor((today-new Date(c.last))/86400000);\n  if(days<WEEKS*7)continue;\n  if(lastSent[c.key]&&lastSent[c.key]>=c.last)continue;\n  out.push({json:{...c,days,weeks:Math.floor(days/7)}});\n}\nreturn out;\n"
   },
   "name": "리마인드 대상 계산",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    460,
    0
   ]
  },
  {
