  {
   "parameters": {
    "jsCode": "\n// 엑셀 행 → 시술기록 행 (네이버 내보내기 컬럼명 자동 인식)\nconst pick=(row,res)=>{for(const k of Object.keys(row)){for(const r of res){if(r.test(k))return row[k]}}return ''};\nconst toDate=v=>{if(v==null||v==='')return null;if(typeof v==='number'){const d=new Date(Math.round((v-25569)*86400000));return isNaN(d)?null:d}\n  const m=String(v).match(/(\\d{4})[.\\-\\/년]\\s*(\\d{1,2})[.\\-\\/월]\\s*(\\d{1,2})/);if(m)return new Date(+m[1],+m[2]-1,+m[3]);const d=new Date(v);return isNaN(d)?null:d};\nconst fmt=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;\nconst out=[];\nfor(const {json:r} of $input.all()){\n  const name=String(pick(r,[/예약자명/,/고객명/,/이름/])).trim(); const d=toDate(pick(r,[/이용일/,/시술일/,/예약일/]));\n  if(!name||!d)continue;\n  const phone=String(pick(r,[/연락처/,/전화/])).trim(); const service=String(pick(r,[/예약상품/,/시술/,/메뉴/])).trim();\n  const no=String(pick(r,[/예약번호/])).trim()||[name,phone,fmt(d),service].join('|');\n  out.push({json:{예약번호:no,이용일:fmt(d),고객명:name,연락처:phone,시술:service,상태:String(pick(r,[/예약상태/,/상태/])||'이용완료').trim(),\n    금액:Number(String(pick(r,[/결제금액/,/금액/])).replace(/[^\\d]/g,''))||0,메모:String(pick(r,[/요청사항/,/메모/])).trim()}});\n}\nreturn out;\n"
   },
